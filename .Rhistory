group_by(year) |>
summarise(n = sum(pop)) |>
ggplot(aes(x = year, y = n)) +
geom_line() +
geom_point() +
scale_y_continuous(labels = scales::label_number(scale = 1e6)) +
labs(x = "Ano", y = "População",
title = "População mundial entre 1952 e 2007") +
theme_minimal()
